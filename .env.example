# Nexora AI - environment template
# Copy this file to .env and fill in real values.
# Never commit .env - it contains secrets.

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Tavily (web search)
TAVILY_API_KEY=tvly-replace-me

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexora

# Auth
JWT_SECRET=replace-with-a-long-random-string

# HubSpot (optional - can also be set via the Integrations UI)
HUBSPOT_ACCESS_TOKEN=

# Encryption key for stored integration credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
