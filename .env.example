# ============================================================
# Nexora AI — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# ============================================================

# --- App ---
PROJECT_NAME=Nexora AI
VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# --- Database (PostgreSQL) ---
# Local:  postgresql+psycopg://user:pass@localhost:5432/nexora_db
# Docker: postgresql+psycopg://nexora:nexora@db:5432/nexora_db
DATABASE_URL=postgresql+psycopg://nexora_user:change_me@localhost:5432/nexora_db

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Fernet key for encrypting OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- OpenAI ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Gmail OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Create OAuth 2.0 Client ID (Desktop or Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/v1/integrations/gmail/callback

# --- HubSpot ---
# Private App Access Token from HubSpot -> Settings -> Integrations -> Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-...

# --- Tavily (web research for the research agent) ---
# Get from https://tavily.com
TAVILY_API_KEY=