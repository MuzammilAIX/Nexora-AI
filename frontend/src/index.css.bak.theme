@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-background text-gray-300 font-sans antialiased;
  }
  * {
    @apply border-border;
  }
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #374151;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #4B5563;
}
.bg-dot-pattern {
  background-color: #0B0F19;
  background-image: radial-gradient(#1F2937 1px, transparent 1px);
  background-size: 20px 20px;
}

.bg-dot-pattern {
  background-color: #0B0F19;
  background-image: radial-gradient(#1F2937 1px, transparent 1px);
  background-size: 20px 20px;
}
