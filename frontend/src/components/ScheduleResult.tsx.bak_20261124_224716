import { Calendar, Download, Clock } from 'lucide-react'

type ScheduleResultProps = {
  result: any
}

function fmtTime(iso: string) {
  try {
    return new Date(iso).toLocaleTimeString('en-US', {
      hour: '2-digit', minute: '2-digit', hour12: false,
    })
  } catch { return iso || '' }
}

function fmtDay(iso: string) {
  try {
    const d = new Date(iso + 'T00:00:00')
    return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
  } catch { return iso }
}

function makeICS(items: any[]) {
  const stamp = (d: Date) => d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z'
  const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Nexora AI//Schedule//EN']
  for (const it of items) {
    const start = new Date(it.start)
    const end = it.end ? new Date(it.end) : new Date(start.getTime() + 30 * 60000)
    lines.push(
      'BEGIN:VEVENT',
      'UID:' + (it.entry_id || it.id || Math.random()) + '@nexora.ai',
      'DTSTAMP:' + stamp(new Date()),
      'DTSTART:' + stamp(start),
      'DTEND:' + stamp(end),
      'SUMMARY:' + (it.title || 'Event'),
      'END:VEVENT'
    )
  }
  lines.push('END:VCALENDAR')
  return lines.join('\r\n')
}

export function ScheduleResult({ result }: ScheduleResultProps) {
  const items = result?.items || []
  const rangeStart = result?.range_start || result?.date || ''
  const rangeEnd = result?.range_end || result?.date || ''
  const isRange = rangeStart && rangeEnd && rangeStart !== rangeEnd
  const headerLabel = isRange
    ? rangeStart + ' – ' + rangeEnd
    : (rangeStart || 'Schedule')

  if (!items.length && !result?.formatted) return null

  const downloadICS = () => {
    const blob = new Blob([makeICS(items)], { type: 'text/calendar;charset=utf-8;' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = 'schedule-' + (rangeStart || 'events') + '.ics'
    a.click()
    URL.revokeObjectURL(url)
  }

  return (
    <div className="mt-2 bg-panel border border-border rounded-xl overflow-hidden">
      <div className="p-3 border-b border-border flex items-start justify-between gap-3 flex-wrap">
        <div className="min-w-0">
          <div className="text-sm font-semibold flex items-center gap-2">
            <Calendar className="w-4 h-4 text-primary" />
            {headerLabel}
          </div>
          <div className="text-xs text-muted mt-0.5">
            {items.length === 0 ? 'No events' : items.length + ' event' + (items.length !== 1 ? 's' : '')}
          </div>
        </div>
        {items.length > 0 && (
          <button onClick={downloadICS} className="text-xs px-2 py-1 rounded bg-primary/10 hover:bg-primary/20 flex items-center gap-1" title="Download .ics">
            <Download className="w-3 h-3" /> .ics
          </button>
        )}
      </div>

      {items.length === 0 ? (
        <div className="p-4 text-center text-sm text-muted">No events scheduled in this range.</div>
      ) : (
        <div className="overflow-x-auto max-h-96 overflow-y-auto">
          <table className="w-full text-xs">
            <thead className="bg-panelHover sticky top-0">
              <tr>
                {isRange && <th className="px-2 py-1.5 text-left font-semibold">Day</th>}
                <th className="px-2 py-1.5 text-left font-semibold">Time</th>
                <th className="px-2 py-1.5 text-left font-semibold">Title</th>
                <th className="px-2 py-1.5 text-left font-semibold">Type</th>
                <th className="px-2 py-1.5 text-left font-semibold">Source</th>
              </tr>
            </thead>
            <tbody>
              {items.map((it: any, i: number) => {
                const day = (it.start || '').slice(0, 10)
                return (
                  <tr key={it.entry_id || it.id || i} className="border-t border-border/50">
                    {isRange && <td className="px-2 py-1 whitespace-nowrap text-muted">{fmtDay(day)}</td>}
                    <td className="px-2 py-1 whitespace-nowrap">
                      <span className="flex items-center gap-1">
                        <Clock className="w-3 h-3 text-muted" />
                        {it.all_day ? 'All day' : (fmtTime(it.start) + (it.end ? ' – ' + fmtTime(it.end) : ''))}
                      </span>
                    </td>
                    <td className="px-2 py-1 font-medium">{it.title}</td>
                    <td className="px-2 py-1 text-muted">{it.entry_type || '—'}</td>
                    <td className="px-2 py-1 text-muted">{it.source || '—'}</td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )
}