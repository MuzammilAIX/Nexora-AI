import { Download, FileSpreadsheet, FileText, Table as TableIcon } from 'lucide-react'

type AnalyticsResultProps = {
  result: any
}

export function AnalyticsResult({ result }: AnalyticsResultProps) {
  if (!result?.table?.columns) return null
  const { columns, rows } = result.table
  const metrics = result.metrics || {}
  const narrative = result.narrative || {}
  const title = result.range_label || result.period || 'Report'
  const stamp = new Date().toISOString().slice(0, 10)

  const downloadCSV = () => {
    const esc = (v: any) => '"' + String(v ?? '').replace(/"/g, '""') + '"'
    const csv = [columns.join(','), ...rows.map((r: any[]) => r.map(esc).join(','))].join('\n')
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `sales-report-${stamp}.csv`
    a.click()
    URL.revokeObjectURL(url)
  }

  const downloadExcel = async () => {
    const XLSX = await import('xlsx')
    const ws = XLSX.utils.aoa_to_sheet([columns, ...rows])
    const wb = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(wb, ws, 'Report')
    XLSX.writeFile(wb, `sales-report-${stamp}.xlsx`)
  }

  const downloadPDF = async () => {
    const { jsPDF } = await import('jspdf')
    const autoTable = (await import('jspdf-autotable')).default
    const doc = new jsPDF()
    doc.setFontSize(16)
    doc.text(`Business Report - ${title}`, 14, 20)
    doc.setFontSize(10)
    const rev = Number(metrics.total_revenue || 0).toLocaleString(undefined, { maximumFractionDigits: 2 })
    const aov = Number(metrics.avg_order_value || 0).toLocaleString(undefined, { maximumFractionDigits: 2 })
    doc.text(`Revenue: $${rev} | Orders: ${metrics.order_count || 0} | AOV: $${aov} | Customers: ${metrics.distinct_customers || 0}`, 14, 28)
    autoTable(doc, {
      startY: 36,
      head: [columns],
      body: rows.map((r: any[]) => r.map((v) => String(v ?? ''))),
      styles: { fontSize: 8 },
    })
    doc.save(`sales-report-${stamp}.pdf`)
  }

  return (
    <div className="mt-2 bg-panel border border-border rounded-xl overflow-hidden">
      <div className="p-3 border-b border-border flex items-start justify-between gap-3 flex-wrap">
        <div className="min-w-0">
          <div className="text-sm font-semibold flex items-center gap-2">
            <TableIcon className="w-4 h-4 text-primary" />
            {title}
          </div>
          <div className="text-xs text-muted mt-0.5">
            Revenue: ${Number(metrics.total_revenue || 0).toLocaleString(undefined, { maximumFractionDigits: 2 })}
            {' · '}Orders: {metrics.order_count || 0}
            {' · '}AOV: ${Number(metrics.avg_order_value || 0).toFixed(2)}
            {' · '}Customers: {metrics.distinct_customers || 0}
          </div>
        </div>
        <div className="flex gap-1">
          <button onClick={downloadCSV} className="text-xs px-2 py-1 rounded bg-primary/10 hover:bg-primary/20 flex items-center gap-1" title="Download CSV">
            <Download className="w-3 h-3" /> CSV
          </button>
          <button onClick={downloadExcel} className="text-xs px-2 py-1 rounded bg-primary/10 hover:bg-primary/20 flex items-center gap-1" title="Download Excel">
            <FileSpreadsheet className="w-3 h-3" /> Excel
          </button>
          <button onClick={downloadPDF} className="text-xs px-2 py-1 rounded bg-primary/10 hover:bg-primary/20 flex items-center gap-1" title="Download PDF">
            <FileText className="w-3 h-3" /> PDF
          </button>
        </div>
      </div>

      {narrative.summary && (
        <div className="p-3 border-b border-border text-sm space-y-2">
          <p>{narrative.summary}</p>
          {narrative.highlights?.length > 0 && (
            <ul className="list-disc list-inside text-xs text-muted space-y-0.5">
              {narrative.highlights.map((h: string, i: number) => <li key={i}>{h}</li>)}
            </ul>
          )}
        </div>
      )}

      <div className="overflow-x-auto max-h-80 overflow-y-auto">
        <table className="w-full text-xs">
          <thead className="bg-panelHover sticky top-0">
            <tr>{columns.map((c: string) => <th key={c} className="px-2 py-1.5 text-left font-semibold">{c}</th>)}</tr>
          </thead>
          <tbody>
            {rows.map((r: any[], i: number) => (
              <tr key={i} className="border-t border-border/50 hover:bg-panelHover/50">
                {r.map((v: any, j: number) => <td key={j} className="px-2 py-1">{typeof v === 'number' ? v.toLocaleString() : String(v ?? '')}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}