import { useState, useEffect, useMemo } from 'react'
import {
  ChevronLeft,
  ChevronRight,
  Plus,
  Trash2,
  Pencil,
  X,
  Calendar as CalendarIcon,
  Clock,
} from 'lucide-react'

type EntryType = 'meeting' | 'shift' | 'task' | 'deadline'

type Entry = {
  id: string
  title: string
  entry_type: EntryType
  start_at: string
  end_at: string | null
  all_day: boolean
  recurrence: string | null
  recurrence_until: string | null
  notes: string | null
}

const API = (import.meta as any).env?.VITE_API_URL || 'http://127.0.0.1:8001'

const authHeaders = () => ({
  'Content-Type': 'application/json',
  Authorization: `Bearer ${localStorage.getItem('nexora_token') || ''}`,
})

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
]
const DAY_NAMES = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
const ENTRY_TYPES: EntryType[] = ['meeting', 'shift', 'task', 'deadline']

function ymd(d: Date) {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(
    d.getDate()
  ).padStart(2, '0')}`
}

function monthKey(d: Date) {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
}

function sameDay(a: Date, b: Date) {
  return (
    a.getFullYear() === b.getFullYear() &&
    a.getMonth() === b.getMonth() &&
    a.getDate() === b.getDate()
  )
}

function fmtTime(iso: string) {
  try {
    return new Date(iso).toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    })
  } catch {
    return iso
  }
}

function startOfCalendarGrid(d: Date): Date {
  const first = new Date(d.getFullYear(), d.getMonth(), 1)
  const dow = (first.getDay() + 6) % 7
  const start = new Date(first)
  start.setDate(first.getDate() - dow)
  return start
}

function calendarCells(monthDate: Date): Date[] {
  const start = startOfCalendarGrid(monthDate)
  const cells: Date[] = []
  for (let i = 0; i < 42; i++) {
    const d = new Date(start)
    d.setDate(start.getDate() + i)
    cells.push(d)
  }
  return cells
}

const typeColors: Record<EntryType, string> = {
  meeting: 'bg-accent/20 text-accent',
  shift: 'bg-primary/20 text-primary',
  task: 'bg-warning/20 text-warning',
  deadline: 'bg-danger/20 text-danger',
}

export function Schedule() {
  const [cursor, setCursor] = useState<Date>(() => new Date())
  const [entries, setEntries] = useState<Entry[]>([])
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [selectedDay, setSelectedDay] = useState<Date>(() => new Date())
  const [modalOpen, setModalOpen] = useState(false)
  const [editing, setEditing] = useState<Entry | null>(null)

  const [title, setTitle] = useState('')
  const [entryType, setEntryType] = useState<EntryType>('meeting')
  const [date, setDate] = useState(ymd(new Date()))
  const [startTime, setStartTime] = useState('09:00')
  const [endTime, setEndTime] = useState('10:00')
  const [allDay, setAllDay] = useState(false)
  const [recurrence, setRecurrence] = useState('')
  const [notes, setNotes] = useState('')

  const cells = useMemo(() => calendarCells(cursor), [cursor])

  async function loadMonth(d: Date) {
    setLoading(true)
    setError(null)
    try {
      const res = await fetch(`${API}/api/v1/schedule?month=${monthKey(d)}`, {
        headers: authHeaders(),
      })
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      const data = await res.json()
      setEntries(Array.isArray(data) ? data : data.items || [])
    } catch (e: any) {
      setError(e?.message || 'Failed to load schedule')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    loadMonth(cursor)
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [cursor])

  function openAdd(day?: Date) {
    setEditing(null)
    const d = day || selectedDay || new Date()
    setDate(ymd(d))
    setTitle('')
    setEntryType('meeting')
    setStartTime('09:00')
    setEndTime('10:00')
    setAllDay(false)
    setRecurrence('')
    setNotes('')
    setModalOpen(true)
  }

  function openEdit(e: Entry) {
    setEditing(e)
    const s = new Date(e.start_at)
    const en = e.end_at ? new Date(e.end_at) : new Date(s.getTime() + 30 * 60 * 1000)
    setDate(ymd(s))
    setStartTime(
      `${String(s.getHours()).padStart(2, '0')}:${String(s.getMinutes()).padStart(2, '0')}`
    )
    setEndTime(
      `${String(en.getHours()).padStart(2, '0')}:${String(en.getMinutes()).padStart(2, '0')}`
    )
    setTitle(e.title)
    setEntryType(e.entry_type)
    setAllDay(e.all_day)
    setRecurrence(e.recurrence || '')
    setNotes(e.notes || '')
    setModalOpen(true)
  }

  async function handleSave() {
    if (!title.trim()) {
      alert('Title is required')
      return
    }
    const startAt = allDay ? `${date}T00:00:00` : `${date}T${startTime}:00`
    const endAt = allDay ? null : `${date}T${endTime}:00`
    const payload: any = {
      title: title.trim(),
      entry_type: entryType,
      start_at: startAt,
      end_at: endAt,
      all_day: allDay,
      notes: notes || null,
    }
    if (recurrence) payload.recurrence = recurrence.toUpperCase()

    try {
      const url = editing
        ? `${API}/api/v1/schedule/${editing.id}`
        : `${API}/api/v1/schedule`
      const method = editing ? 'PATCH' : 'POST'
      const res = await fetch(url, {
        method,
        headers: authHeaders(),
        body: JSON.stringify(payload),
      })
      if (!res.ok) {
        const txt = await res.text()
        throw new Error(`HTTP ${res.status}: ${txt}`)
      }
      setModalOpen(false)
      loadMonth(cursor)
    } catch (e: any) {
      alert(`Save failed: ${e?.message}`)
    }
  }

  async function handleDelete(e: Entry) {
    if (!confirm(`Delete "${e.title}"?`)) return
    try {
      const res = await fetch(`${API}/api/v1/schedule/${e.id}`, {
        method: 'DELETE',
        headers: authHeaders(),
      })
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      loadMonth(cursor)
    } catch (err: any) {
      alert(`Delete failed: ${err?.message}`)
    }
  }

  const entriesByDay = useMemo(() => {
    const map = new Map<string, Entry[]>()
    for (const e of entries) {
      const d = new Date(e.start_at)
      const k = ymd(d)
      if (!map.has(k)) map.set(k, [])
      map.get(k)!.push(e)
    }
    return map
  }, [entries])

  const selectedEntries = entriesByDay.get(ymd(selectedDay)) || []
  const today = new Date()

  return (
    <div className="p-4 md:p-6 max-w-7xl mx-auto">
      <div className="flex items-center justify-between mb-4">
        <h1 className="text-xl font-semibold flex items-center gap-2">
          <CalendarIcon className="w-5 h-5 text-primary" /> Schedule
        </h1>
        <button
          onClick={() => openAdd()}
          className="text-sm px-4 py-2 rounded-lg bg-accent text-white font-medium shadow-md hover:opacity-90 flex items-center gap-2"
        >
          <Plus className="w-4 h-4" /> Add Event
        </button>
      </div>

      {error && <div className="text-sm text-danger mb-2">Error: {error}</div>}

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div className="lg:col-span-2 bg-panel border border-border rounded-xl p-4">
          <div className="flex items-center justify-between mb-3">
            <button
              onClick={() =>
                setCursor(new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1))
              }
              className="p-1.5 rounded hover:bg-panelHover"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>
            <div className="text-base font-semibold">
              {MONTH_NAMES[cursor.getMonth()]} {cursor.getFullYear()}
            </div>
            <button
              onClick={() =>
                setCursor(new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1))
              }
              className="p-1.5 rounded hover:bg-panelHover"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>

          <div className="grid grid-cols-7 gap-1 text-xs text-muted mb-1">
            {DAY_NAMES.map((d) => (
              <div key={d} className="text-center py-1 font-medium">
                {d}
              </div>
            ))}
          </div>
          <div className="grid grid-cols-7 gap-1">
            {cells.map((d, i) => {
              const key = ymd(d)
              const dayEntries = entriesByDay.get(key) || []
              const isCurrentMonth = d.getMonth() === cursor.getMonth()
              const isToday = sameDay(d, today)
              const isSelected = sameDay(d, selectedDay)
              return (
                <button
                  key={i}
                  onClick={() => setSelectedDay(d)}
                  onDoubleClick={() => openAdd(d)}
                  className={`relative min-h-[70px] p-1 rounded border text-left transition-colors ${
                    isSelected
                      ? 'border-primary bg-primary/5'
                      : 'border-border hover:bg-panelHover'
                  } ${!isCurrentMonth ? 'opacity-40' : ''}`}
                >
                  <div className={`text-xs font-semibold ${isToday ? 'text-primary' : ''}`}>
                    {d.getDate()}
                  </div>
                  <div className="mt-0.5 space-y-0.5">
                    {dayEntries.slice(0, 2).map((e) => (
                      <div
                        key={e.id}
                        className={`text-[10px] px-1 py-0.5 rounded truncate ${
                          typeColors[e.entry_type] || 'bg-panelHover'
                        }`}
                      >
                        {e.all_day ? '•' : fmtTime(e.start_at)} {e.title}
                      </div>
                    ))}
                    {dayEntries.length > 2 && (
                      <div className="text-[10px] text-muted">
                        +{dayEntries.length - 2} more
                      </div>
                    )}
                  </div>
                </button>
              )
            })}
          </div>
          {loading && <div className="text-xs text-muted mt-2">Loading…</div>}
        </div>

        <div className="bg-panel border border-border rounded-xl p-4">
          <div className="flex items-center justify-between mb-2">
            <div>
              <div className="text-base font-semibold">
                {selectedDay.toLocaleDateString('en-US', {
                  weekday: 'long',
                  month: 'short',
                  day: 'numeric',
                })}
              </div>
              <div className="text-xs text-muted">
                {selectedEntries.length} event
                {selectedEntries.length !== 1 ? 's' : ''}
              </div>
            </div>
            <button
              onClick={() => openAdd(selectedDay)}
              className="text-xs px-2.5 py-1.5 rounded-md bg-accent/15 text-accent font-medium hover:bg-accent/25 border border-accent/30"
            >
              + Add
            </button>
          </div>
          <div className="space-y-2 max-h-[500px] overflow-y-auto">
            {selectedEntries.length === 0 && (
              <div className="text-xs text-muted py-4 text-center">
                No events scheduled for this day.
              </div>
            )}
            {selectedEntries.map((e) => (
              <div
                key={e.id}
                className="border border-border rounded-lg p-2 hover:bg-panelHover group"
              >
                <div className="flex items-start justify-between gap-2">
                  <div className="min-w-0">
                    <div className="text-sm font-medium truncate">{e.title}</div>
                    <div className="text-xs text-muted flex items-center gap-1 mt-0.5">
                      <Clock className="w-3 h-3" />
                      {e.all_day
                        ? 'All day'
                        : `${fmtTime(e.start_at)}${
                            e.end_at ? ` – ${fmtTime(e.end_at)}` : ''
                          }`}
                    </div>
                    <div className="text-[10px] uppercase tracking-wide mt-1">
                      <span
                        className={`px-1.5 py-0.5 rounded ${
                          typeColors[e.entry_type] || 'bg-panelHover'
                        }`}
                      >
                        {e.entry_type}
                      </span>
                      {e.recurrence && (
                        <span className="ml-1 text-muted">↻ {e.recurrence}</span>
                      )}
                    </div>
                  </div>
                  <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button
                      onClick={() => openEdit(e)}
                      className="p-1 rounded hover:bg-panelHover"
                      title="Edit"
                    >
                      <Pencil className="w-3 h-3" />
                    </button>
                    <button
                      onClick={() => handleDelete(e)}
                      className="p-1 rounded hover:bg-panelHover text-danger"
                      title="Delete"
                    >
                      <Trash2 className="w-3 h-3" />
                    </button>
                  </div>
                </div>
                {e.notes && (
                  <div className="text-xs text-muted mt-1 line-clamp-2">{e.notes}</div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      {modalOpen && (
        <div
          className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50"
          onClick={() => setModalOpen(false)}
        >
          <div
            className="bg-panel border border-border rounded-xl p-4 w-full max-w-md"
            onClick={(ev) => ev.stopPropagation()}
          >
            <div className="flex items-center justify-between mb-3">
              <h2 className="text-sm font-semibold">
                {editing ? 'Edit Event' : 'Add Event'}
              </h2>
              <button
                onClick={() => setModalOpen(false)}
                className="p-1 rounded hover:bg-panelHover"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="space-y-2">
              <div>
                <label className="text-xs text-muted block mb-0.5">Title *</label>
                <input
                  value={title}
                  onChange={(e) => setTitle(e.target.value)}
                  className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                  placeholder="Meeting title…"
                  autoFocus
                />
              </div>
              <div>
                <label className="text-xs text-muted block mb-0.5">Type</label>
                <select
                  value={entryType}
                  onChange={(e) => setEntryType(e.target.value as EntryType)}
                  className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                >
                  {ENTRY_TYPES.map((t) => (
                    <option key={t} value={t}>
                      {t}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label className="text-xs text-muted block mb-0.5">Date</label>
                <input
                  type="date"
                  value={date}
                  onChange={(e) => setDate(e.target.value)}
                  className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                />
              </div>
              <label className="flex items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  checked={allDay}
                  onChange={(e) => setAllDay(e.target.checked)}
                />
                All day
              </label>
              {!allDay && (
                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <label className="text-xs text-muted block mb-0.5">Start</label>
                    <input
                      type="time"
                      value={startTime}
                      onChange={(e) => setStartTime(e.target.value)}
                      className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                    />
                  </div>
                  <div>
                    <label className="text-xs text-muted block mb-0.5">End</label>
                    <input
                      type="time"
                      value={endTime}
                      onChange={(e) => setEndTime(e.target.value)}
                      className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                    />
                  </div>
                </div>
              )}
              <div>
                <label className="text-xs text-muted block mb-0.5">
                  Recurrence (optional)
                </label>
                <select
                  value={recurrence}
                  onChange={(e) => setRecurrence(e.target.value)}
                  className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                >
                  <option value="">None</option>
                  <option value="DAILY">Daily</option>
                  <option value="WEEKLY">Weekly</option>
                  <option value="MONTHLY">Monthly</option>
                </select>
              </div>
              <div>
                <label className="text-xs text-muted block mb-0.5">Notes</label>
                <textarea
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  className="w-full bg-background border border-border rounded px-2 py-1.5 text-sm"
                  rows={2}
                />
              </div>
            </div>

            <div className="flex justify-end gap-2 mt-4">
              <button
                onClick={() => setModalOpen(false)}
                className="text-sm px-3 py-1.5 rounded border border-border hover:bg-panelHover"
              >
                Cancel
              </button>
              <button
                onClick={handleSave}
                className="text-sm px-4 py-2 rounded-lg bg-accent text-white font-medium hover:opacity-90"
              >
                {editing ? 'Update' : 'Save'}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}